{
  "manifest_version": 3,
  "name": "OnTab",
  "version": "1.1.0",
  "description": "Suspend tabs to a lightweight placeholder and restore them later.",
  "permissions": [
    "contextMenus",
    "tabs",
    "storage",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OnTab",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/tab-placeholder-16.png",
    "24": "icons/icon-24.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "minimum_chrome_version": "102"
}
